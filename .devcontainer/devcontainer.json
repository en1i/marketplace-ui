{
  "name": "Marketplace UI DevContainer",
  "dockerComposeFile": ["../compose.yml", "docker-compose.yml"],
  "service": "marketplace-ui",
  "workspaceFolder": "/usr/app",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Marketplace UI",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome"]
    }
  },
  "remoteUser": "node",
  "shutdownAction": "stopCompose"
}
