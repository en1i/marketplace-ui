{
  "permissions": {
    "allow": [
      "Bash(yarn lint *)",
      "Bash(yarn biome *)",
      "Bash(yarn test *)",
      "Bash(yarn build *)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:api.anthropic.com)",
      "Bash(yarn format *)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(node *)",
      "Read(//home/alex/dev/marketplace/**)",
      "Bash(yarn dev *)",
      "Skill(agent-browser)",
      "Bash(agent-browser --version)",
      "Bash(agent-browser skills *)",
      "Bash(agent-browser open *)",
      "Bash(agent-browser wait *)",
      "Bash(agent-browser snapshot *)",
      "Bash(agent-browser doctor *)",
      "Bash(agent-browser get *)",
      "Bash(agent-browser click *)",
      "Skill(update-config)",
      "Bash(gh pr *)",
      "Bash(gh api *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; [[ \"$f\" == /home/alex/dev/marketplace/marketplace-ui/* ]] && /home/alex/dev/marketplace/marketplace-ui/node_modules/.bin/biome check --write \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting…"
          }
        ]
      }
    ]
  }
}
